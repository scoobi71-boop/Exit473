Options -Indexes

# Deny dotfiles, the secrets file, SQL schemas, and example configs
<FilesMatch "(^\.|^config\.php$|\.sql$|\.example$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
