Options -Indexes

# Deny dotfiles (.adminpass, .htpasswd, .git, etc.) and the auth include
<FilesMatch "(^\.|^auth\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
